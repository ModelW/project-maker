# Project maker's own files. The template has its own .gitignore files (which
# also apply here, as the template is developed in place).

# Python
__pycache__/
*.py[cod]
.venv/
/dist/
*.egg-info/

# Tooling caches and reports
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node (the template front)
node_modules/

# Secrets
.env

# Logs
*.log

# OS and editors
.DS_Store
*.swp
*~
.idea/
.vscode/
