# All variables are validated in src/env.ts (except the build-time ones)

# :: IF api__enable
API_URL=http://localhost:8000
# :: ENDIF

# Sentry (an empty DSN disables error reporting)
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# Sentry source maps upload, build time only (optional)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=
