    "devDependencies": {
        "@sveltejs/adapter-node": "5.5.x",
        "@sveltejs/kit": "2.70.x",
        "@sveltejs/vite-plugin-svelte": "7.3.x",
        "@types/eslint": "9.6.x",
        "@types/node": "24.x",
        "@typescript-eslint/eslint-plugin": "8.71.x",
        "@typescript-eslint/parser": "8.71.x",
        "eslint": "10.12.x",
        "eslint-config-prettier": "10.1.x",
        "eslint-plugin-svelte": "3.23.x",
        "prettier": "3.9.x",
        "prettier-plugin-svelte": "4.1.x",
        "sass": "1.105.x",
        "svelte": "5.57.x",
        "svelte-check": "4.7.x",
